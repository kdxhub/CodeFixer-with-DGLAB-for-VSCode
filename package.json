{
  "contributes": {
    "keybindings": [
      {
        "command": "dglab.server.pause.forced",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      }
    ],
    "commands": [
      {
        "command": "dglab.open_config",
        "title": "DGLAB: 打开拓展设置"
      },
      {
        "command": "dglab.server.stop",
        "title": "DGLAB: 关闭WebSocket"
      },
      {
        "command": "dglab.server.pause",
        "title": "DGLAB: 临时暂停"
      },
      {
        "command": "dglab.server.pause.forced",
        "title": "DGLAB: 紧急暂停"
      },
      {
        "command": "dglab.server.start",
        "title": "DGLAB: 开启WebSocket"
      },
      {
        "command": "dglab.update",
        "title": "DGLAB: 强制刷新工作状态"
      },
      {
        "command": "dglab.detail",
        "title": "DGLAB: 切换工作状态"
      }
    ],
    "configuration": [
      {
        "title": "代码纠错",
        "properties": {
          "codefixer-with-dg-lab.code.side": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "bothAll",
              "bothAvg",
              "mixed"
            ],
            "enumItemLabels": [
              "仅左侧",
              "仅右侧",
              "全部",
              "分摊",
              "随机"
            ],
            "enumDescriptions": [
              "电流仅输出到A通道。",
              "电流仅输出到B通道。",
              "两个通道都会输出。",
              "两个通道都会输出指定强度的一半。",
              "在强度叠加前进行随机，两个通道被选中的概率均等。"
            ],
            "default": "mixed",
            "description": "电流往哪个电极输出。"
          },
          "codefixer-with-dg-lab.code.infoFirst": {
            "type": "integer",
            "default": 0,
            "description": "第一个信息增加的强度\n（提示：下文全部强度都可以输入负数，此时表示触发时抵消强度）"
          },
          "codefixer-with-dg-lab.code.infoEvery": {
            "type": "integer",
            "default": 0,
            "description": "除了第一个信息以外的每个信息增加的强度"
          },
          "codefixer-with-dg-lab.code.infoMax": {
            "type": "integer",
            "default": 0,
            "description": "除了第一个信息以外的最大信息计入数量"
          },
          "codefixer-with-dg-lab.code.warnFirst": {
            "type": "integer",
            "default": 5,
            "description": "第一个警告增加的强度"
          },
          "codefixer-with-dg-lab.code.warnEvery": {
            "type": "integer",
            "default": 3,
            "description": "除了第一个警告以外的每个警告增加的强度"
          },
          "codefixer-with-dg-lab.code.warnMax": {
            "type": "integer",
            "default": 3,
            "description": "除了第一个警告以外的最大警告计入数量"
          },
          "codefixer-with-dg-lab.code.errorFirst": {
            "type": "integer",
            "default": 15,
            "description": "第一个错误增加的强度"
          },
          "codefixer-with-dg-lab.code.errorEvery": {
            "type": "integer",
            "default": 8,
            "description": "除了第一个错误以外的每个错误增加的强度"
          },
          "codefixer-with-dg-lab.code.errorMax": {
            "type": "integer",
            "default": 3,
            "description": "除了第一个错误以外的最大错误计入数量"
          }
        }
      },
      {
        "title": "终端纠错",
        "properties": {
          "codefixer-with-dg-lab.terminal.side": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "bothAll",
              "bothAvg",
              "mixed"
            ],
            "enumItemLabels": [
              "仅左侧",
              "仅右侧",
              "全部",
              "分摊",
              "随机"
            ],
            "enumDescriptions": [
              "电流仅输出到A通道。",
              "电流仅输出到B通道。",
              "两个通道都会输出。",
              "两个通道都会输出指定强度的一半。",
              "在强度叠加前进行随机，两个通道被选中的概率均等。"
            ],
            "default": "mixed",
            "description": "强度往哪个电极输出。其中默认值 mixed 表示随机，其它的都是字面意思。"
          },
          "codefixer-with-dg-lab.terminal.inrevertable": {
            "type": "boolean",
            "default": true,
            "description": "控制强度能否下降。默认值 true 表示可以下降。"
          },
          "codefixer-with-dg-lab.terminal.rate": {
            "type": "number",
            "default": 0.5,
            "description": "当终端产生错误时，将错误代码转换为强度的倍率。\n将 %ERRORLEVEL% 或者 $? 乘以此系数得到的值作为强度。\n如果设为 0 则禁用本功能。"
          },
          "codefixer-with-dg-lab.terminal.duration": {
            "type": "integer",
            "default": 3000,
            "description": "当终端产生错误时，强度将叠加多长时间。单位毫秒\n如果设为 0 则禁用本功能。"
          },
          "codefixer-with-dg-lab.terminal.interruptSeeAs": {
            "type": "integer",
            "default": 0,
            "description": "终端命令被 Ctrl+C 等终端导致没有返回码时视作返回了多少。\n本配置是受 rate 影响之前的值。"
          },
          "codefixer-with-dg-lab.terminal.tips": {
            "type": "string",
            "default": "杂鱼～命令执行出错了哦～要狠狠电击惩罚一下了呢，再加%strength%档～～",
            "description": "当终端产生错误时，进行什么提示。设置为空不提示。\n可以使用的占位符： %strength% = 当前惩罚强度；%duration% = 当前惩罚时间（毫秒）。"
          }
        }
      },
      {
        "title": "行为反馈回路机制设定",
        "properties": {
          "codefixer-with-dg-lab.award.side": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "bothAll",
              "bothAvg",
              "mixed"
            ],
            "enumItemLabels": [
              "仅左侧",
              "仅右侧",
              "全部",
              "分摊",
              "随机"
            ],
            "enumDescriptions": [
              "电流仅输出到A通道。",
              "电流仅输出到B通道。",
              "两个通道都会输出。",
              "两个通道都会输出指定强度的一半。",
              "在强度叠加前进行随机，两个通道被选中的概率均等。"
            ],
            "default": "mixed",
            "description": "行为反馈电流往哪个电极输出。"
          },
          "codefixer-with-dg-lab.award.debugging.breakpoint.new": {
            "type": "integer",
            "default": 15,
            "description": "当「调试：新增断点」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.debugging.breakpoint.remove": {
            "type": "integer",
            "default": 15,
            "description": "当「调试：移除断点」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.debugging.breakpoint.new.duration": {
            "type": "integer",
            "default": 2000,
            "description": "「调试：新增断点」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.debugging.breakpoint.remove.duration": {
            "type": "integer",
            "default": 1500,
            "description": "「调试：移除断点」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.debugging.stop.act": {
            "type": "integer",
            "default": 10,
            "description": "当「调试：结束」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.debugging.stop.duration": {
            "type": "integer",
            "default": 3000,
            "description": "「调试：结束」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.debugging.start.act": {
            "type": "integer",
            "default": 10,
            "description": "当「调试：开始」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.debugging.start.duration": {
            "type": "integer",
            "default": 3000,
            "description": "「调试：开始」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.typing.act": {
            "type": "integer",
            "default": 1,
            "description": "当「键入字符」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.typing.duration": {
            "type": "integer",
            "default": 700,
            "description": "「键入字符」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.scm.commit.act": {
            "type": "integer",
            "default": -20,
            "description": "当「源代码管理：提交」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.scm.commit.duration": {
            "type": "integer",
            "default": 5000,
            "description": "「源代码管理：提交」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.create.act": {
            "type": "integer",
            "default": 5,
            "description": "当「新建文件」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.create.duration": {
            "type": "integer",
            "default": 2000,
            "description": "「新建文件」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.open.act": {
            "type": "integer",
            "default": 10,
            "description": "当「打开」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.open.duration": {
            "type": "integer",
            "default": 2000,
            "description": "「打开」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          },
          "codefixer-with-dg-lab.award.save.act": {
            "type": "integer",
            "default": 12,
            "description": "当「保存」时要增加的强度。"
          },
          "codefixer-with-dg-lab.award.save.duration": {
            "type": "integer",
            "default": 3000,
            "description": "「保存」行为带来的强度的持续时间，小于等于0为不使用本功能。"
          }
        }
      },
      {
        "title": "WebSocket服务器",
        "properties": {
          "codefixer-with-dg-lab.server.port": {
            "type": "integer",
            "default": 59999,
            "description": "服务器端口"
          },
          "codefixer-with-dg-lab.server.override_ip": {
            "type": "string",
            "default": "",
            "description": "服务器IP，不为空将覆盖自动检测结果。\n推荐仅在必要时才使用。"
          },
          "codefixer-with-dg-lab.server.qrcode.correctionLevel": {
            "type": [
              "L",
              "M",
              "Q",
              "H"
            ],
            "default": "Q",
            "description": "二维码纠错级别，越大的纠错级别扫描成功率更高，也更慢。从低到高为 L M Q H。"
          },
          "codefixer-with-dg-lab.server.qrcode.size": {
            "type": "integer",
            "default": 320,
            "description": "生成的二维码的大小（像素）。越大的值生成所需要的时间越长。"
          }
        }
      },
      {
        "title": "其它",
        "properties": {
          "codefixer-with-dg-lab.pulse.left": {
            "type": "string",
            "enum": [
              "呼吸",
              "潮汐",
              "连击",
              "快速按捏",
              "按捏渐强",
              "心跳节奏",
              "压缩",
              "节奏步伐",
              "颗粒摩擦",
              "渐变弹跳",
              "波浪涟漪",
              "雨水冲刷",
              "变速敲击",
              "信号灯",
              "挑逗1",
              "挑逗2",
              "随机"
            ],
            "default": "随机",
            "description": "设置左通道波形。"
          },
          "codefixer-with-dg-lab.pulse.right": {
            "type": "string",
            "enum": [
              "呼吸",
              "潮汐",
              "连击",
              "快速按捏",
              "按捏渐强",
              "心跳节奏",
              "压缩",
              "节奏步伐",
              "颗粒摩擦",
              "渐变弹跳",
              "波浪涟漪",
              "雨水冲刷",
              "变速敲击",
              "信号灯",
              "挑逗1",
              "挑逗2",
              "随机"
            ],
            "default": "随机",
            "description": "设置右通道波形。"
          },
          "codefixer-with-dg-lab.cast.show": {
            "type": "boolean",
            "default": true,
            "description": "是否要在状态栏显示被映射系数影响前的数值。该设置会在左右系数均为 1.0 时禁用。"
          },
          "codefixer-with-dg-lab.cast.left": {
            "type": "number",
            "default": 1.0,
            "description": "左侧最终强度映射系数：最终输出的强度是计算后的结果乘以本系数。小于等于0会禁用此通道输出。"
          },
          "codefixer-with-dg-lab.cast.right": {
            "type": "number",
            "default": 1.0,
            "description": "右侧最终强度映射系数：最终输出的强度是计算后的结果乘以本系数。小于等于0会禁用此通道输出。"
          }
        }
      }
    ]
  },
  "name": "codefixer-with-dg-lab",
  "displayName": "CodeFixer with DG-LAB",
  "description": "一种基于DGLAB与碳基低速神经网络的自动纠错插件",
  "repository": {
    "url": "https://github.com/kdxhub/CodeFixer-with-DGLAB-for-VSCode"
  },
  "author": {
    "email": "kdxiaoyi@outlook.com",
    "name": "kdxiaoyi",
    "url": "https://kdx233.github.io"
  },
  "publisher": "kdxiaoyi",
  "version": "0.2.1",
  "icon": "./images/icon_320.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./src/entry.js",
  "scripts": {
    "vscode:prepublish": "esbuild ./src/entry.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "@vscode/vsce": "^3.7.1",
    "qrcode": "^1.5.4",
    "uuid": "^8.3.2",
    "ws": "^8.19.0"
  }
}
